# Copy to deploy/pullback.env; keep that file private (chmod 600).
# Compose uses raw KEY=value format: do not add quotes, inline comments,
# shell commands or variable references to values. Dollar signs are literal.
# Set a new random password of at least 8 characters before starting.
PULLBACK_PASSWORD=

# The default installation has no demo data and makes no provider requests.
PULLBACK_DEMO=0
PULLBACK_MARKET_WORKER=0
# Optional comma-separated symbols already in the research pool (maximum 10).
# Example: AAPL.US,600519.SH. Empty disables 1m/5m historical sampling.
PULLBACK_MINUTE_SYMBOLS=

# Optional read-only credentials owned by this application, never chat tokens.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Legacy manual-file recovery only; the restore CLI already invalidates state.
# Keep 0 when using npm run restore -- BACKUP_PATH NEW_DATABASE_PATH.
PULLBACK_RESTORED=0

# Export PULLBACK_ORIGIN=https://research.example.com in the operator's shell.
# Compose supplies that same public origin to both the app and Caddy.
# Do not put PULLBACK_ORIGIN or infrastructure overrides in this secrets file.
