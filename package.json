{
  "name": "pullback-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "start": "node --import tsx apps/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "probe": "node --import tsx scripts/probe.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "format": "prettier --write apps packages scripts tests *.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0",
    "fastify": "5.12.5",
    "lightweight-charts": "5.2.1",
    "longbridge": "5.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
